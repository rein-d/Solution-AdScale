@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title C4 Container — AdScale: данные по сервисам (Database per Service)

skinparam legendBackgroundColor #F7F7F7
skinparam legendBorderColor #BBBBBB
skinparam legendFontColor #222222

Person_Ext(adv, "Рекламодатель", "Кабинет, отчёты, бюджеты")
Person_Ext(user, "Пользователь", "Показ / клик")
Person_Ext(dsp, "DSP-партнёры", "OpenRTB 2.6 / HTTPS")

System_Boundary(adscale, "AdScale Platform") {

    Container(gw, "API Gateway", "Envoy", "TLS/mTLS, квоты, breaker,\nJSON → gRPC")
    Container(bidding, "Bidding Service", "Go + C++", "Bid Edge + Auction Core;\nрешение ≤ 55 мс")
    Container(campaign, "Campaign Service", "REST/JSON", "Единственный писатель\nконфигурации кампаний")
    Container(collector, "Event Collector", "Go", "Приём beacon;\nstateless")
    Container(stats, "Statistics Service", "consumer", "Факты показов/кликов,\nминутные агрегаты")
    Container(billing, "Billing Service", "consumer", "Ledger, балансы,\nсчета, сверка")
    Container(reporting, "Reporting", "consumer", "Сборка и обновление\nвитрин mart.*")
    Container(analytics, "Analytics Service", "OLAP", "Тяжёлые отчёты,\nread-only")
    Container(cabinet, "Cabinet BFF", "REST", "Кабинет рекламодателя,\nread-кеш")
    Container(dspAdapter, "DSP Adapter", "Go", "Синхронизация и маппинги\nидентификаторов")
}

System_Boundary(stores, "Хранилища — Database per Service") {

    ContainerDb(pgBid, "Bidding DB", "PostgreSQL", "config_release, политики,\nsnapshot, outbox, audit")
    ContainerDb(redisBid, "Hot State", "Redis Cluster · 6 шардов", "pacing, frequency cap,\nрезерв бюджета, kill switch")
    ContainerDb(pgCamp, "Campaign DB", "PostgreSQL", "кампании, бюджеты,\nтаргетинг, версии, outbox")
    ContainerDb(redisRl, "Rate Limit Store", "Redis Cluster · 3 шарда", "квоты партнёров")
    ContainerDb(redisCache, "Read Cache", "Redis Cluster · 3 шарда", "cfg:*, bff:*, JWKS")
    ContainerQueue(kafka, "Event Backbone", "Apache Kafka", "impression, click, spend,\ncampaign.changed, bid.decided")
    ContainerDb(chStats, "Statistics Store", "ClickHouse · 4 шарда × 2", "stats.impression, click,\nминутные агрегаты")
    ContainerDb(chAnalytics, "Analytics Store", "ClickHouse read-контур", "mart.*, тяжёлые отчёты")
    ContainerDb(pgBilling, "Billing DB", "PostgreSQL · sync + DR", "ledger_entry, spend_batch,\naccount, invoice, outbox")
    ContainerDb(s3Creatives, "Creatives + CDN", "S3 + CDN", "ассеты креативов,\nimmutable URL")
    ContainerDb(s3Archive, "Data Lake", "S3 · Parquet", "сырые события > 90 дней,\nархив витрин")
    ContainerDb(s3Worm, "Finance Archive", "S3 Object Lock", "счета, акты, архив ledger")
}

' --- вход ---
Rel(dsp, gw, "Bid request / response", "OpenRTB 2.6, HTTPS")
Rel(gw, bidding, "Decide", "gRPC / mTLS")
Rel(user, collector, "Beacon", "HTTPS, async")
Rel(adv, cabinet, "Управление и отчёты", "HTTPS")

' --- запись: один писатель на набор ---
Rel(bidding, pgBid, "конфиг, аудит, outbox", "SQL")
Rel(bidding, redisBid, "проверка и резерв", "Lua / RESP")
Rel(bidding, kafka, "bid.decided, bid.no_bid", "idempotent producer")

Rel(campaign, pgCamp, "CRUD, версии, outbox", "SQL")
Rel(campaign, s3Creatives, "ассеты креативов", "S3 API")
Rel(campaign, kafka, "campaign.changed (outbox)", "producer")

Rel(collector, kafka, "impression, click", "acks=all")

Rel(stats, chStats, "batch insert + агрегаты", "Native")
Rel(stats, kafka, "consumer group", "consume")

Rel(billing, pgBilling, "ledger + баланс + outbox", "SQL, sync commit")
Rel(billing, kafka, "spend (outbox)", "producer")
Rel(billing, redisBid, "watermark сверки", "SET")

Rel(reporting, kafka, "consumer group", "consume")
Rel(reporting, chStats, "читает факты", "Native")
Rel(reporting, chAnalytics, "пишет mart.*", "Native")

Rel(analytics, chAnalytics, "тяжёлые запросы", "Native")
Rel(analytics, s3Archive, "история > 90 дней", "S3 / Parquet")
Rel(chStats, s3Archive, "S3 Sink", "Parquet")

' --- чтение ---
Rel(gw, redisRl, "квоты партнёров", "EVALSHA")
Rel(cabinet, redisCache, "кеш отчётов и списков", "RESP")
Rel(cabinet, campaign, "CRUD через API", "REST")
Rel(cabinet, billing, "баланс и счета", "REST")
Rel(dspAdapter, campaign, "конфигурация", "REST / события")

legend right
  **Один писатель на набор**
  - Кампании — только Campaign,
    деньги — только Billing,
    факты — только Statistics.
  - Чужие таблицы не читаем напрямую:
    API или событие.
  - Кеш и Kafka ≠ источник истины.

  **Почему разные хранилища**
  - Конфиг/версии/ACID → PostgreSQL.
  - Поток 1–3 млрд строк/сут → Kafka + ClickHouse.
  - Деньги/ledger → PostgreSQL + sync-реплика.
  - Бинарники креативов → S3 + CDN.

  **Ориентиры**
  18k → 50k RPS, P95 bid ≤ 55 мс,
  потеря событий ≤ 0,01 %
endlegend

Lay_D(dsp, gw)
Lay_D(gw, bidding)
Lay_R(bidding, pgBid)
Lay_D(pgBid, redisBid)
Lay_R(campaign, pgCamp)
Lay_D(pgCamp, s3Creatives)
Lay_D(kafka, chStats)

@enduml
